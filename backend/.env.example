OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_API_KEY_UW_MAIL=your_uw_mail_openrouter_key_here # optional fallback key
OPENROUTER_API_KEY_PERSONAL=your_personal_openrouter_key_here # optional fallback key
JINA_API_KEY=your_jina_key_here # optional
TAVILY_API_KEY=your_tavily_key_here # optional, enables search presence and competitor evidence
ENABLE_AGENTIC_LAYER=true
AGENTIC_PROFILE_BASE_URL=http://localhost:3001/agent
AGENTIC_PROFILE_STORAGE=memory
# AGENTIC_PROFILE_STORAGE=file writes local JSON records to backend/data/agentic-profiles by default.
# AGENTIC_PROFILE_DATA_DIR=data/agentic-profiles
PORT=3001
